        {
            "name": "konsole",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.2/src/konsole-26.08.2.tar.xz",
                    "sha256": "2154a03a952c29be435defffd4c88f9d2eff44a55cdfa33b16a8fc7bfd978217",

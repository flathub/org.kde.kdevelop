                    }
                }
            ]
        },
        {
            "name": "konsole",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.0/src/konsole-26.08.0.tar.xz",
                    "sha256": "19d909a6f18440b28dc6492e97172aa070a3ac425d94d8bbb89a01979a2ce666",

                    }
                }
            ]
        },
        {
            "name": "ktexttemplate",
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/frameworks/6.26/ktexttemplate-6.26.0.tar.xz",
                    "sha256": "8b84643c32caf58812fec5a910a1fb98865bc7f91e778af860fa98b79d0ff038",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8762,

                    "url": "https://download.kde.org/stable/release-service/26.04.3/src/kdev-python-26.04.3.tar.xz",
                    "sha256": "1ad26eccfd1cc28b4cf5ffb91b252739b1b954d9a989446e1e0809ecda8c5a52",

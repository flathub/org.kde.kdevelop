                    }
                }
            ]
        },
        {
            "name": "ktexttemplate",
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/frameworks/6.29/ktexttemplate-6.29.0.tar.xz",
                    "sha256": "6ca3b4be8a76fff109297a5c6b1d23f5d55fa4b4110575d4c3287ee8b10619a9",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8762,

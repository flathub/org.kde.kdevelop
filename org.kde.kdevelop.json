                    "url": "https://download.kde.org/stable/release-service/26.08.2/src/kdev-python-26.08.2.tar.xz",
                    "sha256": "5e87eb114f4ebceb8adeb28a25165c52293702a69c13ef2e5fb7f18b20b0a6b0",
